{
  "name": "dsh-tokenbank-multi",
  "version": "0.3.0",
  "description": "DSH 免费模型多账号版：一个面板管理多个 TokenBank 账号，查看余额、一键签到、切换账号；内置本地网关把请求轮流分发到各账号，自动跳过限流与故障账号。基于 dsh-tokenbank 改造。官网 https://bank.skillpie.cn",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tokenbank",
    "multi-account"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkylnj/dsh-tokenbank-multi.git"
  },
  "homepage": "https://github.com/wkylnj/dsh-tokenbank-multi#readme",
  "bugs": {
    "url": "https://github.com/wkylnj/dsh-tokenbank-multi/issues"
  },
  "main": "./lib/index.js",
  "scripts": {
    "test": "node test/verify-multi.mjs && node test/verify-flows.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "icon.svg",
    "lib",
    "locale/*.json"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
