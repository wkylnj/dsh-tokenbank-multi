{
  "name": "dsh-tokenbank-multi",
  "version": "0.4.0",
  "description": "DSH 多渠道中转站轮转管理：每个渠道独立实现（TokenBank、星驰），共用本地网关按渠道令牌分流，自动跳过限流与故障账号。官网 https://bank.skillpie.cn",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tokenbank",
    "xingchi",
    "multi-account",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkylnj/dsh-tokenbank-multi.git"
  },
  "homepage": "https://github.com/wkylnj/dsh-tokenbank-multi#readme",
  "bugs": {
    "url": "https://github.com/wkylnj/dsh-tokenbank-multi/issues"
  },
  "main": "./lib/index.js",
  "scripts": {
    "test": "node test/verify-multi.mjs && node test/verify-flows.mjs && node test/verify-xingchi.mjs && node test/verify-channels.mjs && node test/verify-render.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "icon.svg",
    "lib",
    "locale/*.json"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
