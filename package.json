{
  "name": "dsh-tokenbank-multi",
  "version": "0.2.0",
  "description": "DSH 免费模型多账号版：在一个面板里管理多个 TokenBank 账号，随时切换、一键签到、查看余额；切换账号即切换模型分组的 API Key（credentials 每次请求重新解析，无需重启）。基于 dsh-tokenbank 改造，移除了充值、托管与交易入口。官网 https://bank.skillpie.cn",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tokenbank",
    "multi-account"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkylnj/dsh-tokenbank-multi.git"
  },
  "homepage": "https://github.com/wkylnj/dsh-tokenbank-multi#readme",
  "bugs": {
    "url": "https://github.com/wkylnj/dsh-tokenbank-multi/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "assets",
    "assets/frizon-tokenbank.woff",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "lib",
    "locale/*.json"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
